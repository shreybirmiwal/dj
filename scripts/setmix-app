#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(dirname -- "$script_dir")
python_bin="$project_dir/.venv/bin/python"

if [ ! -x "$python_bin" ]; then
  echo "SetMix virtual environment is missing. Run: python3 -m venv .venv" >&2
  exit 1
fi

cd "$project_dir"
exec "$python_bin" -m setmix.desktop "$@"
